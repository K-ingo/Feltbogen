{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strenge tjek */

    /* `strict` er summen af de tjek TypeScript kan lave, og den kostede
       ingenting her: koden var ren under den, allerede inden den blev slået
       til. Det er ikke tilfældigt — den skriver `?? []` og `| null` overalt,
       Dexie-tabellerne i db.ts har deres `!`, og der er ingen utypede
       parametre. Flaget gør den disciplin til noget oversætteren håndhæver
       frem for noget man skal huske.

       Vigtigst er `strictNullChecks`: uden den er en type som `Tur | null` en
       kommentar, og man må gerne læse .navn på den. Med den slår det fejl. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
